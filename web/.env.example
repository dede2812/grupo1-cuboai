# Reino Commerce · variables de entorno.
# El proyecto LEE este archivo al arrancar si lo copiás a `.env`
# (cargador propio en config/settings.py); exportarlas también funciona.
# NUNCA commitear valores reales.

# Entorno: dev (defecto) | staging | prod
REINO_ENV=dev

# Django (obligatorias en staging/prod: el arranque falla sin ellas)
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_ORIGINS=

# Base de datos: vacío => SQLite local. Para PostgreSQL usá DATABASE_URL
# (postgres://usuario:clave@host:5432/base) o POSTGRES_DB/USER/PASSWORD/HOST.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Royal Stylist (IA real). Sin REINO_AI_API_KEY el asesor opera en modo
# "rules" (etiquetado en la UI) y la tienda funciona completa.
REINO_AI_PROVIDER=openai
REINO_AI_API_KEY=
REINO_AI_BASE_URL=https://api.openai.com/v1
REINO_AI_MODEL=gpt-4o-mini
REINO_AI_TIMEOUT=12

# Reserva de stock durante el checkout (minutos)
REINO_RESERVATION_MINUTES=10

# Correo transaccional (revisión 2, §18). Sin habilitar: los eventos quedan
# BLOQUEADOS con estado preciso, nunca marcados como enviados.
REINO_EMAIL_ENABLED=0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Reino Commerce <no-reply@reino-commerce.local>

# Carga de imágenes del estudio de diseño (bytes; 3 MB por defecto)
REINO_MEDIA_MAX_BYTES=3145728

# Protección del seed destructivo fuera de desarrollo (auditoría §9.5)
# REINO_ALLOW_SEED=1

# Seguridad HTTPS (solo staging/prod)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
# Proveedores: JSON secreto inyectado desde el entorno; nunca subir credenciales.
# Estructura y campos por cuenta/tienda: docs/09_PAGOS_Y_LOGISTICA.md
REINO_PAYMENT_ACCOUNTS={}
REINO_SHIPPING_ACCOUNTS={}
